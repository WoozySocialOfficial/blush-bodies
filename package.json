{
  "name": "blush_bodies_app",
  "version": "1.0.0",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0"
  },
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "lodash": "4.18.1",
    "lucide-react-native": "^1.47.0",
    "patch-package": "8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "cspell": "^10.3.6",
    "expo-doctor": "^1.21.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "spellcheck": "cspell App.tsx index.ts src cspell.json",
    "doctor": "expo-doctor",
    "test:planning": "node --experimental-strip-types --test tests/planning.test.mjs",
    "check:bundles": "expo export --platform all --output-dir .expo-check --clear",
    "check": "npm run typecheck && npm run test:planning && npm run spellcheck && npm run doctor && npm run check:bundles",
    "build:web": "expo export --platform web --output-dir dist",
    "start:web": "serve -s dist -l $PORT -c ../serve.json"
  },
  "private": true
}
